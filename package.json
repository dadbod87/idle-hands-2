{
  "name": "idle-hands-2",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && tsc -p tsconfig.design.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check:plan": "python3 tools/idle-hands-2.py check && python3 tests/idle-hands-2-tracker.test.py",
    "town:db": "node --experimental-strip-types tools/town-db.ts start",
    "town:server": "node --experimental-strip-types tools/run-local-server.ts",
    "town:test-server": "node --experimental-strip-types tools/browser-server.ts",
    "test:server": "node --experimental-strip-types tools/run-server-tests.ts",
    "check:design": "tsc -p tsconfig.design.json && node --experimental-strip-types tools/check-design-plan.ts"
  },
  "dependencies": {
    "pg": "8.16.3",
    "phaser": "4.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.5",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
