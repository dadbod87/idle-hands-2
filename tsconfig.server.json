{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "server/**/*.ts",
    "tests/server-*.test.ts",
    "tools/prove-cafe-candidate-restart.ts",
    "tools/prove-housing-process.ts",
    "tools/housing-restart-proof.ts",
    "tools/prove-database-restart.ts",
    "tools/profile-browser.ts",
    "tools/public-client.ts",
    "tools/public-refresh-fixture.ts",
    "tools/session-child.ts",
    "tools/session-process.ts",
    "src/vite-env.d.ts",
    "tools/public-refresh.ts",
    "tests/public-refresh.spec.ts"
  ]
}
